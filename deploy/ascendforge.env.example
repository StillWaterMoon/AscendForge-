# /etc/ascendforge/ascendforge.env
# chmod 600, owned by the service user.

ASCENDFORGE_DATA_DIR=/var/lib/ascendforge
ASCENDFORGE_HOST=127.0.0.1
ASCENDFORGE_PORT=8080
ASCENDFORGE_SECURE_COOKIES=true
ASCENDFORGE_SESSION_TTL=43200

# 32-byte urlsafe-base64 Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to generate $DATA_DIR/secrets/master.key on first start.
ASCENDFORGE_SECRET_KEY=

# Optional first-run token. If empty, a random token is generated and printed
# once by the server console.
ASCENDFORGE_SETUP_TOKEN=

# Optional non-interactive first admin (only when no users exist).
ASCENDFORGE_ADMIN_USER=admin
ASCENDFORGE_ADMIN_PASSWORD=

ASCENDFORGE_WORKER_ID=worker-1
ASCENDFORGE_WORKER_POLL_SECONDS=1.0
ASCENDFORGE_LEASE_SECONDS=120
ASCENDFORGE_LOG_LEVEL=INFO

# docker is strongly recommended on the server; local cannot enforce no-network.
ASCENDFORGE_EXECUTOR=docker
ASCENDFORGE_EXECUTOR_IMAGE=python:3.12-slim
ASCENDFORGE_EXECUTOR_TIMEOUT=30
ASCENDFORGE_EXECUTOR_MEMORY_MB=512
ASCENDFORGE_EXECUTOR_CPUS=1.0
ASCENDFORGE_EXECUTOR_ALLOW_NETWORK=0

ASCENDFORGE_CANNJUDGE_BASE_URL=https://cannjudge.cn
ASCENDFORGE_MAX_PACKAGE_MB=64
