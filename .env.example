# AscendForge environment configuration.
# Copy to .env (never commit it) or export these variables in the service unit.

# --- Storage -------------------------------------------------------------
# Root of persistent state. On a server mount this on a durable volume.
ASCENDFORGE_DATA_DIR=/var/lib/ascendforge

# --- Web server ----------------------------------------------------------
ASCENDFORGE_HOST=0.0.0.0
ASCENDFORGE_PORT=8080
# Set true only when the browser reaches the service through HTTPS.
ASCENDFORGE_SECURE_COOKIES=false
# Session lifetime in seconds (default 12h).
ASCENDFORGE_SESSION_TTL=43200

# --- Secrets -------------------------------------------------------------
# 32-byte urlsafe-base64 Fernet key. If empty, AscendForge generates
# $DATA_DIR/secrets/master.key on first start (chmod 600).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASCENDFORGE_SECRET_KEY=

# Token required by the first-run /setup page. If empty, a random token is
# generated on first start and printed once in the server log.
ASCENDFORGE_SETUP_TOKEN=

# Optional: create the first admin non-interactively (only used when the DB
# has no users). Prefer the /setup page or `python -m ascendforge user create`.
ASCENDFORGE_ADMIN_USER=admin
ASCENDFORGE_ADMIN_PASSWORD=

# --- Worker --------------------------------------------------------------
ASCENDFORGE_WORKER_ID=worker-1
ASCENDFORGE_WORKER_POLL_SECONDS=1.0
# Maximum time a worker lease is valid. Crash recovery resets expired leases.
ASCENDFORGE_LEASE_SECONDS=120
ASCENDFORGE_LOG_LEVEL=INFO

# --- Execution -----------------------------------------------------------
# docker | local | auto  (docker strongly recommended on the server)
ASCENDFORGE_EXECUTOR=auto
ASCENDFORGE_EXECUTOR_IMAGE=python:3.12-slim
ASCENDFORGE_EXECUTOR_TIMEOUT=30
ASCENDFORGE_EXECUTOR_MEMORY_MB=512
ASCENDFORGE_EXECUTOR_CPUS=1.0
# Set to 1 only if you accept that generated code may use the network.
ASCENDFORGE_EXECUTOR_ALLOW_NETWORK=0

# --- CANNJudge -----------------------------------------------------------
ASCENDFORGE_CANNJUDGE_BASE_URL=https://cannjudge.cn
# Limit for ZIP downloads of problem packages.
ASCENDFORGE_MAX_PACKAGE_MB=64
